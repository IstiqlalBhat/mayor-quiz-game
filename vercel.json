{
  "version": 2,
  "routes": [
    { "src": "/api/test", "dest": "/api/test.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/api/game/new", "dest": "/api/game/new.js" },
    { "src": "/api/game/save", "dest": "/api/game/save.js" },
    { "src": "/api/game/complete", "dest": "/api/game/complete.js" },
    { "src": "/api/leaderboard", "dest": "/api/leaderboard.js" },
    { "src": "/(.*)", "dest": "/html/$1" }
  ]
}
